# ==============================================================================
# NEXUS EDGE Environment Configuration
# Phase 3: Multimodal Perception & Hardware-Aware AI Runtime
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend API URL (leave empty for same-origin relative /api/v1 routing)
VITE_API_BASE_URL=

# Runtime Engine Providers & Policy (Phase 2)
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_DEFAULT_PROVIDER=auto

# Provider Activation Gates (Actual hardware & SDK availability still verified)
NEXUS_ENABLE_CPU=true
NEXUS_ENABLE_GPU=true
NEXUS_ENABLE_QNN=true

# Model Cache and Storage
NEXUS_MODEL_CACHE_DIR=./data/models

# Telemetry & Benchmarking
NEXUS_RUNTIME_TELEMETRY=true
NEXUS_BENCHMARK_ENABLED=true

# Qualcomm Snapdragon QNN Paths (Populate if running on Snapdragon hardware)
NEXUS_QNN_SDK_PATH=
NEXUS_QNN_LIB_PATH=
NEXUS_QNN_BACKEND=HTP

# ==============================================================================
# Multimodal Perception Engine Configuration (Phase 3)
# ==============================================================================
NEXUS_PERCEPTION_ENABLED=true

NEXUS_TEXT_ENABLED=true
NEXUS_SCREEN_ENABLED=true
NEXUS_CAMERA_ENABLED=true
NEXUS_VOICE_ENABLED=true
NEXUS_DOCUMENT_ENABLED=true

# Operational Modality Controls
NEXUS_SCREEN_CAPTURE_ENABLED=true
NEXUS_SCREEN_CAPTURE_MODE=on_demand
NEXUS_CAMERA_MODE=on_demand
NEXUS_VOICE_MODE=push_to_talk

NEXUS_SPEECH_PROVIDER=browser
NEXUS_OCR_ENABLED=true
NEXUS_OCR_PROVIDER=local
NEXUS_VISION_ENABLED=true
NEXUS_VISION_PROVIDER=local

NEXUS_DOCUMENT_MAX_SIZE_MB=25

# Strict Privacy Guard & Zero Raw-Media Storage
NEXUS_PRIVACY_GUARD_ENABLED=true
NEXUS_STORE_RAW_AUDIO=false
NEXUS_STORE_RAW_CAMERA=false
NEXUS_STORE_RAW_SCREEN=false

NEXUS_CONTEXT_ENABLED=true
