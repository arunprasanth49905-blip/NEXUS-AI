# ==============================================================================
# NEXUS EDGE Environment Configuration
# Phase 2: Hardware-Aware AI Runtime Engine
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend API URL (leave empty for same-origin relative /api/v1 routing)
VITE_API_BASE_URL=

# Runtime Engine Providers & Policy
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_DEFAULT_PROVIDER=auto

# Provider Activation Gates (Actual hardware & SDK availability still verified)
NEXUS_ENABLE_CPU=true
NEXUS_ENABLE_GPU=true
NEXUS_ENABLE_QNN=true

# Model Cache and Storage
NEXUS_MODEL_CACHE_DIR=./data/models

# Telemetry & Benchmarking
NEXUS_RUNTIME_TELEMETRY=true
NEXUS_BENCHMARK_ENABLED=true

# Qualcomm Snapdragon QNN Paths (Populate if running on Snapdragon hardware)
# Note: NEXUS_ENABLE_QNN=true alone does not claim QNN is ready; native SDK must exist
NEXUS_QNN_SDK_PATH=
NEXUS_QNN_LIB_PATH=
NEXUS_QNN_BACKEND=HTP
