# ==============================================================================
# NEXUS EDGE Environment Configuration
# Phase 4: Context Intelligence, Memory Engine & Hardware-Aware Runtime
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend API URL (leave empty for same-origin relative /api/v1 routing)
VITE_API_BASE_URL=

# Runtime Engine Providers & Policy (Phase 2)
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_DEFAULT_PROVIDER=auto

# Provider Activation Gates (Actual hardware & SDK availability still verified)
NEXUS_ENABLE_CPU=true
NEXUS_ENABLE_GPU=true
NEXUS_ENABLE_QNN=true

# Model Cache and Storage
NEXUS_MODEL_CACHE_DIR=./data/models

# Telemetry & Benchmarking
NEXUS_RUNTIME_TELEMETRY=true
NEXUS_BENCHMARK_ENABLED=true

# Qualcomm Snapdragon QNN Paths (Populate if running on Snapdragon hardware)
NEXUS_QNN_SDK_PATH=
NEXUS_QNN_LIB_PATH=
NEXUS_QNN_BACKEND=HTP

# ==============================================================================
# Multimodal Perception Engine Configuration (Phase 3)
# ==============================================================================
NEXUS_PERCEPTION_ENABLED=true

NEXUS_TEXT_ENABLED=true
NEXUS_SCREEN_ENABLED=true
NEXUS_CAMERA_ENABLED=true
NEXUS_VOICE_ENABLED=true
NEXUS_DOCUMENT_ENABLED=true

# Operational Modality Controls
NEXUS_SCREEN_CAPTURE_ENABLED=true
NEXUS_SCREEN_CAPTURE_MODE=on_demand
NEXUS_CAMERA_MODE=on_demand
NEXUS_VOICE_MODE=push_to_talk

NEXUS_SPEECH_PROVIDER=browser
NEXUS_OCR_ENABLED=true
NEXUS_OCR_PROVIDER=local
NEXUS_VISION_ENABLED=true
NEXUS_VISION_PROVIDER=local

NEXUS_DOCUMENT_MAX_SIZE_MB=25

# Strict Privacy Guard & Zero Raw-Media Storage
NEXUS_PRIVACY_GUARD_ENABLED=true
NEXUS_STORE_RAW_AUDIO=false
NEXUS_STORE_RAW_CAMERA=false
NEXUS_STORE_RAW_SCREEN=false

# ==============================================================================
# Context Intelligence & Memory Engine Configuration (Phase 4)
# ==============================================================================
NEXUS_CONTEXT_ENABLED=true
NEXUS_MEMORY_ENABLED=true

NEXUS_SESSION_MEMORY_ENABLED=true
NEXUS_PROJECT_MEMORY_ENABLED=true
NEXUS_LONG_TERM_MEMORY_ENABLED=true

NEXUS_MEMORY_STORAGE=sqlite
NEXUS_MEMORY_DB_PATH=./data/nexus_memory.db

NEXUS_MEMORY_MAX_ITEMS=1000
NEXUS_CONTEXT_MAX_ITEMS=50
NEXUS_CONTEXT_MAX_TOKENS=8000

NEXUS_MEMORY_RETRIEVAL_ENABLED=true

NEXUS_EMBEDDING_PROVIDER=local
NEXUS_INTENT_PROVIDER=rule_based
NEXUS_ENTITY_PROVIDER=rule_based

NEXUS_MEMORY_AUTO_SAVE=false
NEXUS_CONTEXT_RETENTION_ENABLED=true
NEXUS_MEMORY_EXPLANATIONS=true

# ==============================================================================
# Agent Orchestration & Intelligent Task Planning Configuration (Phase 5)
# ==============================================================================
NEXUS_AGENTS_ENABLED=true
NEXUS_AGENT_ORCHESTRATION_ENABLED=true
NEXUS_AGENT_PLANNER=rule_based
NEXUS_AGENT_SELECTOR=capability_based
NEXUS_AGENT_MAX_RETRIES=2
NEXUS_AGENT_TIMEOUT_SECONDS=60
NEXUS_AGENT_MAX_STEPS=10
NEXUS_AGENT_PARALLEL_EXECUTION=true
NEXUS_AGENT_APPROVAL_REQUIRED=true
NEXUS_AGENT_AUTO_EXECUTE_SAFE_TASKS=true
NEXUS_AGENT_MEMORY_INTEGRATION=true
NEXUS_AGENT_CONTEXT_SCOPING=true
NEXUS_AGENT_VERIFICATION_ENABLED=true

